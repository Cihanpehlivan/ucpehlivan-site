{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      { "source": "/blog/prompt-yazmak-brief{,/,/index.html}", "destination": "/yazi/prompt-muhendisligi/", "type": 301 },
      { "source": "/blog/prompt-muhendisligi{,/,/index.html}", "destination": "/yazi/prompt-muhendisligi/", "type": 301 },
      { "source": "/blog/bu-meslek-hic-olmadi-promt-muhendisligi{,/,/index.html}", "destination": "/yazi/prompt-muhendisligi/", "type": 301 },
      { "source": "/yazi/bu-meslek-hic-olmadi-promt-muhendisligi{,/,/index.html}", "destination": "/yazi/prompt-muhendisligi/", "type": 301 },
      { "source": "/yazi/prompt-brief{,/,/index.html}", "destination": "/yazi/prompt-muhendisligi/", "type": 301 },
      { "source": "/yazi/prompt-brief/:dosya", "destination": "/yazi/prompt-muhendisligi/:dosya", "type": 301 },
      { "source": "/blog/arac-degil-sonuc{,/,/index.html}", "destination": "/yazi/arac-degil-sonuc/", "type": 301 },
      { "source": "/index.html", "destination": "/", "type": 301 },
      { "source": "/blog/index.html", "destination": "/blog/", "type": 301 },
      { "source": "/yazi/:ad/index.html", "destination": "/yazi/:ad/", "type": 301 }
    ],
    "rewrites": [
      { "source": "/admin", "destination": "/admin/index.html" },
      { "source": "/admin/**", "destination": "/admin/index.html" },
      { "source": "/blog/**", "destination": "/blog/post.html" }
    ],
    "headers": [
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "regex": "^/(.*/)?$", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/admin{,/**}", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "**/*.@(webp|png|jpg|svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
      { "source": "/site.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }] },
      { "source": "/videos.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/feed.xml", "headers": [{ "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" }, { "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.md", "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }, { "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/@(img|media)/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
      { "source": "/admin/**", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
    ]
  },
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" }
}
